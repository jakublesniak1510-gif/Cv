# Klucz Anthropic (generowanie CV i listów). Bez niego działa prosty tryb zapasowy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Stripe (BLIK / karta / Przelewy24 / Google Pay / Apple Pay). Gdy jest klucz, płatności idą przez Stripe.
# Panel Stripe → Developers → API keys: Secret key (sk_live_… albo sk_test_… do testów).
STRIPE_SECRET_KEY=
# Panel Stripe → Developers → Webhooks → endpoint https://<strona>/api/stripe/webhook → Signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=
# p24 = płatności bezpośrednio przez Przelewy24 mimo klucza Stripe
PAY_PROVIDER=

# Przelewy24 (BLIK / karta / szybki przelew / Google Pay / Apple Pay w PLN). Bez tych danych działa tryb DEMO (płatność symulowana).
# Dane znajdziesz w panelu Przelewy24: Moje dane → ID sprzedawcy, klucz CRC i klucz do raportów (API).
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
# 1 = środowisko testowe (sandbox.przelewy24.pl)
P24_SANDBOX=

# Publiczny adres strony (powrót z płatności i powiadomienia Przelewy24)
BASE_URL=http://localhost:3000
PORT=3000

# Wysyłka dokumentów e-mailem (PDF w załącznikach). Dowolny SMTP, np. Resend / Brevo / Gmail:
# Najprościej: login i hasło skrzynki (domyślnie serwer OVH ssl0.ovh.net:465). Hasło wpisz normalnie.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# Albo jedna linijka (zamiast powyższych): SMTP_URL=smtps://uzytkownik:haslo@smtp.resend.com:465
MAIL_FROM=CV Pod Ogłoszenie <dokumenty@twojadomena.pl>
# Twój adres: tu przychodzą wiadomości z formularza kontaktowego i zapytania firm (odpowiedź trafia do nadawcy)
# oraz testowe wydania newslettera z panelu.
CONTACT_EMAIL=

# Panel administratora (/admin). Bez ADMIN_PASSWORD panel jest wyłączony.
# ADMIN_TOTP_SECRET i ADMIN_SESSION_SECRET wygenerujesz poleceniem: node scripts/admin-secret.mjs
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=
# Sól do skrótów e-maili w kodach rabatowych (ustaw raz i nie zmieniaj).
CODE_SALT=

# Reklamy (opcjonalnie). Skrypty Google Ads i Meta Pixel ładują się dopiero po zgodzie w banerze cookie.
# Google Ads → Cele → Konwersje → zakup: identyfikator AW-… i etykieta konwersji.
GADS_ID=
GADS_PURCHASE_LABEL=
# Meta (Facebook/Instagram) → Menedżer zdarzeń → ID Pixela (same cyfry).
META_PIXEL_ID=

# Link do wystawienia opinii w Profilu Firmy w Google (Profil Firmy → „Poproś o opinie” → skopiuj link, np. https://g.page/r/…/review).
# Link widzą wszyscy klienci na stronie dokumentów i w e-mailu z prośbą o ocenę, niezależnie od wystawionej oceny.
GOOGLE_REVIEW_URL=
