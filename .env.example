# Klucz Anthropic (generowanie CV i listów). Bez niego działa prosty tryb zapasowy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Stripe (płatności BLIK / karta / Apple Pay w PLN). Bez klucza działa tryb DEMO (płatność symulowana).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Publiczny adres strony (do powrotu ze Stripe)
BASE_URL=http://localhost:3000
PORT=3000
