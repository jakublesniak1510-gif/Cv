# Klucz Anthropic (generowanie CV i listów). Bez niego działa prosty tryb zapasowy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Stripe (BLIK / karta / Przelewy24 / Google Pay / Apple Pay). Gdy jest klucz, płatności idą przez Stripe.
# Panel Stripe → Developers → API keys: Secret key (sk_live_… albo sk_test_… do testów).
STRIPE_SECRET_KEY=
# Panel Stripe → Developers → Webhooks → endpoint https://<strona>/api/stripe/webhook → Signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Bramka płatności: puste = Stripe (gdy jest klucz), p24 = tylko Przelewy24 mimo klucza Stripe,
# both = klient wybiera w kasie Stripe (BLIK / karta / Apple Pay / Google Pay, domyślnie) albo Przelewy24 – wymaga kluczy obu bramek.
# Karnety i paczki kodów zawsze przez Stripe. Instrukcja: docs/P24.md
PAY_PROVIDER=

# Przelewy24 (BLIK / karta / szybki przelew / Google Pay / Apple Pay w PLN). Bez tych danych działa tryb DEMO (płatność symulowana).
# Dane znajdziesz w panelu Przelewy24: Moje dane → ID sprzedawcy, klucz CRC i klucz do raportów (API).
P24_MERCHANT_ID=
P24_POS_ID=
P24_CRC=
P24_API_KEY=
# 1 = środowisko testowe (sandbox.przelewy24.pl); panel admina pokazuje wtedy baner „P24 sandbox”. Na produkcji usuń.
P24_SANDBOX=

# Publiczny adres strony (powrót z płatności i powiadomienia Przelewy24)
BASE_URL=http://localhost:3000
PORT=3000

# Wysyłka dokumentów e-mailem (PDF w załącznikach). Dowolny SMTP, np. Resend / Brevo / Gmail:
# Najprościej: login i hasło skrzynki (domyślnie serwer OVH ssl0.ovh.net:465). Hasło wpisz normalnie.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# Albo jedna linijka (zamiast powyższych): SMTP_URL=smtps://uzytkownik:haslo@smtp.resend.com:465
MAIL_FROM=CV Pod Ogłoszenie <dokumenty@twojadomena.pl>
# Twój adres: tu przychodzą wiadomości z formularza kontaktowego i zapytania firm (odpowiedź trafia do nadawcy)
# oraz testowe wydania newslettera z panelu.
CONTACT_EMAIL=

# Panel administratora (/admin). Bez ADMIN_PASSWORD panel jest wyłączony.
# ADMIN_TOTP_SECRET i ADMIN_SESSION_SECRET wygenerujesz poleceniem: node scripts/admin-secret.mjs
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=
# Sól do skrótów e-maili w kodach rabatowych (ustaw raz i nie zmieniaj).
CODE_SALT=

# Reklamy (opcjonalnie). Skrypty Google Ads i Meta Pixel ładują się dopiero po zgodzie w banerze cookie.
# Google Ads → Cele → Konwersje → zakup: identyfikator AW-… i etykieta konwersji.
GADS_ID=
GADS_PURCHASE_LABEL=
# Meta (Facebook/Instagram) → Menedżer zdarzeń → ID Pixela (same cyfry).
META_PIXEL_ID=
# Weryfikacja domeny w Meta: Meta Business → Bezpieczeństwo marki → Domeny → „Weryfikacja metatagiem” → wpisz tylko wartość content (sam ciąg znaków).
# Serwis doda <meta name="facebook-domain-verification" content="…"> w nagłówku każdej strony.
META_DOMAIN_VERIFY=

# Link do wystawienia opinii w Profilu Firmy w Google (Profil Firmy → „Poproś o opinie” → skopiuj link, np. https://g.page/r/…/review).
# Link widzą wszyscy klienci na stronie dokumentów i w e-mailu z prośbą o ocenę, niezależnie od wystawionej oceny.
GOOGLE_REVIEW_URL=

# Szkice kreatora („Wyślij mi link do dokończenia”): najwyżej tyle nowych szkiców i e-maili z linkiem na dobę. Domyślnie 300.
DRAFT_DAILY=

# Testy A/B strony głównej (opcjonalnie, bez plików cookie). JSON: identyfikator → % ruchu w wariancie B.
# hero – nagłówek, cta – przycisk główny. Np. EXPERIMENTS={"hero":50,"cta":50}. Pusto = bez testów. Wyniki: panel → SEO.
EXPERIMENTS=

# Oferty pracy w cotygodniowych powiadomieniach (opcjonalnie, tylko oficjalne API partnerskie). Bez kluczy e-maile mają same linki do portali.
# Adzuna: https://developer.adzuna.com → Register → App ID i App Key (kraj pl).
# UWAGA: darmowy klucz = 14-dniowy trial do oceny; użycie komercyjne (wysyłka ofert mailem) wymaga licencji/zgody Adzuna na piśmie – nie ustawiać na produkcji bez niej.
# ADZUNA_LOGO_URL: adres logo z materiałów prasowych Adzuna (min. 116×23 px) do atrybucji „via Adzuna” w e-mailu; bez niego sam link tekstowy.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: https://jooble.org/api/about → klucz API (JOOBLE_HOST domyślnie pl.jooble.org).
# UWAGA: sprawdź regulamin Jooble po otrzymaniu klucza (atrybucja, użycie w e-mailach) przed ustawieniem na produkcji.
JOOBLE_KEY=
# Najwyżej tyle e-maili z ofertami dziennie (reszta wychodzi następnego dnia, poniedziałek–środa). Domyślnie 500.
ALERTS_DAILY_MAX=
ADZUNA_LOGO_URL=
